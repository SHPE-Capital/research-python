# Copy to .env (git-ignored) and fill in. Never commit keys.

# Personal Alpaca market-data keys (a paper account's keys work). Only the data track (D1, D3) needs them.
ALPACA_DATA_KEY=
ALPACA_DATA_SECRET=

# Where downloaded market data lives. Defaults to ./data inside this repo (git-ignored).
RESEARCH_DATA_DIR=

# Request budget shared by every download in one process. The free plan allows 200/min.
ALPACA_DATA_REQUESTS_PER_MINUTE=190
